{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxy-config-center.local/schemas/dns-security.schema.json",
  "title": "DNS Security Policy (Core V2)",
  "type": "object",
  "required": ["enable", "enhanced-mode", "nameserver", "default-nameserver", "proxy-server-nameserver", "fallback", "fallback-filter"],
  "properties": {
    "enable": { "const": true },
    "enhanced-mode": { "const": "fake-ip" },
    "ipv6": { "type": "boolean" },
    "fake-ip-range": { "type": "string" },
    "nameserver": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(https://|h3://|tls://)" }
    },
    "proxy-server-nameserver": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(https://|h3://|tls://)" }
    },
    "fallback": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(https://|h3://|tls://)" }
    },
    "default-nameserver": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "fallback-filter": { "type": "object" },
    "nameserver-policy": { "type": "object" }
  },
  "additionalProperties": true
}
