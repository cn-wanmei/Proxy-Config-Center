{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cn-wanmei/Proxy-Config-Center/common/schemas/proxy-group.schema.json",
  "title": "Proxy Group Schema",
  "description": "Schema for platform-agnostic proxy group definitions in Core",
  "type": "object",
  "required": ["version", "groups"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "object",
            "required": ["zh", "en"],
            "properties": {
              "zh": { "type": "string" },
              "en": { "type": "string" }
            }
          },
          "type": {
            "type": "string",
            "enum": ["select", "url-test", "fallback", "load-balance"]
          },
          "options": { "type": "array" },
          "include-all-nodes": { "type": "boolean" },
          "filter": { "type": "string" },
          "icon": { "type": "string" },
          "default": { "type": "string" },
          "priority": { "type": "integer" },
          "category": { "type": "string" },
          "hidden": { "type": "boolean" },
          "description": {
            "type": "object",
            "properties": {
              "zh": { "type": "string" },
              "en": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
