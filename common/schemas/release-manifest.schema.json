{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cn-wanmei.github.io/Proxy-Config-Center/schemas/release-manifest.schema.json",
  "title": "Proxy-Config-Center Release Manifest",
  "type": "object",
  "required": ["release", "version", "remote_policy", "remote_base", "client_base", "clients", "rules"],
  "properties": {
    "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+"},
    "version": {"type": "string"},
    "remote_policy": {"const": "latest-rules"},
    "remote_base": {"type": "string", "format": "uri"},
    "client_base": {"type": "string", "format": "uri"},
    "clients": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/artifact"}},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["name", "asset", "latest_url", "sha256", "size"],
      "properties": {
        "name": {"type": "string"},
        "asset": {"type": "string"},
        "source": {"type": "string"},
        "latest_url": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
