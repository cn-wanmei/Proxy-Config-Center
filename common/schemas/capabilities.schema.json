{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cn-wanmei/Proxy-Config-Center/schema/capabilities.schema.json",
  "title": "Proxy Config Center Platform Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "features", "limitations"],
  "properties": {
    "platform": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "required": ["rule_provider", "rule_set", "domain_fallback"]
    },
    "limitations": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          { "type": "string", "enum": ["limited"] }
        ]
      }
    }
  }
}
