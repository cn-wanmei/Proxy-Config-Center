{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cn-wanmei/Proxy-Config-Center/schemas/dns.schema.json",
  "title": "DNS Core Schema",
  "type": "object",
  "definitions": {
    "resolver": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "name": { "type": "object" },
        "type": { "enum": ["system", "doh", "doq", "udp", "tcp", "tls"] },
        "servers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "resolvers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "resolvers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "default": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["id", "group", "options", "default"],
      "properties": {
        "id": { "type": "string", "pattern": "^dns-[a-z][a-z0-9-]*$" },
        "group": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "default": { "type": "string" },
        "selectable": { "type": "boolean" }
      }
    }
  }
}
